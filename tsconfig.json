{
    "compilerOptions": {
        "target": "ES2025",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2025"],
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "jsxImportSource": "@tiny-ui/core"
    },
    "include": ["src", "schema"]
}
